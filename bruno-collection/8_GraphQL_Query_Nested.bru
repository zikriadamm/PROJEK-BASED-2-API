meta {
  name: 8 - POST GraphQL Query Nested (Activities & Related Expenses)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/graphql
  body: json
  auth: none
}

headers {
  x-api-key: {{api_key}}
}

body:json {
  {
    "query": "query { activities { id title financialSummary { formatPlafon statusRisiko } currentWeather { temperatureFormatted condition } expenses { id title cost { formatRupiah } } } }"
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("GraphQL data activities dan nested expenses berhasil dikembalikan", function() {
    const body = res.getBody();
    expect(body.data).to.have.property('activities');
    expect(body.data.activities).to.be.an('array');
    expect(body.data.activities[0].expenses).to.be.an('array');
  });
}
