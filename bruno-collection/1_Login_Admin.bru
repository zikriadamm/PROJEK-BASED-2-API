meta {
  name: 1 - POST Login Admin & Auto-Save Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v2/auth/login
  body: json
  auth: none
}

headers {
  x-api-key: {{api_key}}
}

body:json {
  {
    "username": "admin",
    "password": "admin123"
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response memuat token HMAC", function() {
    expect(res.getBody().sukses).to.equal(true);
    expect(res.getBody().token).to.be.a('string');
  });
}

script:post-response {
  if (res.getBody() && res.getBody().token) {
    bru.setVar("auth_token", res.getBody().token);
  }
}
